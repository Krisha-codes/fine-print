---
import "../styles/tokens.css";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fine Print: token test</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Courier+Prime&family=Inter:wght@400;500;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      main { max-width: var(--column); margin: 0 auto; padding: var(--space-5) var(--space-3); }
      .pill {
        display: inline-block; background: var(--red); color: white;
        font-family: var(--font-ui); font-size: 12px; font-weight: 600;
        text-transform: uppercase; padding: 4px 12px; border-radius: 999px;
      }
      .byline { font-family: var(--font-ui); font-size: 13px; color: var(--gray); }
      .dek { font-family: var(--font-hand); font-size: 18px; }
      .mono { font-family: var(--font-mono); }
      .box { border: var(--border); padding: var(--space-3); margin-top: var(--space-4); }
    </style>
  </head>
  <body>
    <main>
      <span class="pill">Receipts</span>
      <h1 style="font-size: 44px; margin-top: 12px;">This is a test headline</h1>
      <p class="byline">By Krisha · Oct 22, 2026 · 4 min read</p>
      <p class="dek">A handwritten excerpt goes here.</p>
      <p>This is body text in PT Serif. It should look like a calm, readable article paragraph with generous line spacing.</p>
      <p class="mono">4 min read (Courier Prime)</p>
      <div class="box">A square-cornered box with a 2px black border.</div>
    </main>
  </body>
</html>