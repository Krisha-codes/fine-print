---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<span class="pill">{label}</span>

<style>
  .pill {
    display: inline-block;
    background: var(--red);
    color: white;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
  }
</style>