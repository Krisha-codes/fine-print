---
import { categories } from "../utils/categories";
import { url } from "../utils/url";
---

<nav class="tabs" aria-label="Browse by category">
  {categories.map((c) => <a class="tab" href={url(`/${c.slug}`)}>{c.label}</a>)}
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .tab {
    font-family: var(--font-display);
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--black);
    border: var(--border);
    border-radius: 999px;
    padding: 6px 18px;
  }
  .tab:hover {
    background: var(--black);
    color: var(--cream);
  }
</style>
