---
import { url } from "../utils/url";

const links = [
  { label: "Home", href: url("/") },
  { label: "News", href: url("/news") },
  { label: "Receipts", href: url("/receipts") },
  { label: "Success Stories", href: url("/success-stories") },
  { label: "About", href: url("/about") },
];
---

<header class="masthead">
  <div class="container masthead__inner">
    <a class="logo" href={url("/")}>
      <span class="logo__stamp">Fine Print</span>
      <span class="logo__tagline">The Parts They Skipped</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="icon-btn" href="#" aria-label="Newsletter">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="5" width="18" height="14" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>
      <a class="icon-btn" href="#" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.6" />
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 4px solid var(--black);
  }
  .masthead__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .logo {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
  }
  .logo__stamp {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.2;
    text-transform: uppercase;
    border: var(--border);
    padding: 2px 10px;
  }
   .logo__tagline {
    font-family: var(--font-hand);
    font-size: 14px;
    color: var(--gray);
    margin-top: var(--space-1);
  }
  .nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--red);
    text-decoration: none;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--red);
  }
</style>